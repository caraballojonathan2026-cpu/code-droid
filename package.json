{
  "name": "code-droid",
  "version": "0.4.1",
  "description": "A featherweight, web-based Android IDE. Kotlin in, APK out. Runs on a 4GB-RAM machine. No Android Studio, no Gradle, no emulator.",
  "main": "server/launcher.js",
  "scripts": {
    "start": "node server/launcher.js",
    "dev": "node server/server.js",
    "setup": "bash tools/install.sh",
    "doctor": "bash tools/doctor.sh",
    "test": "node tools/selftest.js",
    "smoke": "node tools/ui-smoke.js"
  },
  "engines": {
    "node": ">=16"
  },
  "license": "MIT",
  "keywords": [
    "android",
    "ide",
    "kotlin",
    "apk",
    "lightweight",
    "low-ram",
    "web-ide"
  ],
  "repository": "https://github.com/YOUR-USERNAME/code-droid"
}